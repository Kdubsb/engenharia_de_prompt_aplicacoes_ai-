import random from dataclasses import dataclass, field from typing import Optional 

============================================================ 

MODELO DE DADOS 

Estado imutável da partida em um único lugar 

============================================================ 

@dataclass class EstadoJogo: palavra: str letras_corretas: set = field(default_factory=set) letras_erradas: set = field(default_factory=set) max_erros: int = 6 

@property 
def erros(self) -> int: 
   return len(self.letras_erradas) 
 
@property 
def todas_letras_tentadas(self) -> set: 
   return self.letras_corretas | self.letras_erradas 
 
@property 
def ganhou(self) -> bool: 
   return set(self.palavra) <= self.letras_corretas 
 
@property 
def perdeu(self) -> bool: 
   return self.erros >= self.max_erros 
 
@property 
def encerrado(self) -> bool: 
   return self.ganhou or self.perdeu 
 

============================================================ 

MÓDULO DE PALAVRAS 

Responsável exclusivamente por fornecer palavras 

============================================================ 

BANCO_DE_PALAVRAS: list[str] = [ "encapsulamento", "polimorfismo", "heranca", "iterador", "decorador", "generator", "coroutine", "metaclasse", "concorrencia", "paralelismo", "recursao", "algoritmo", "estrutura", "compilador", "interpretador", "depuracao", ] 

def sortear_palavra(banco: list[str] = BANCO_DE_PALAVRAS) -> str: """Retorna uma palavra aleatória do banco fornecido.""" return random.choice(banco) 

============================================================ 

MÓDULO DE VERIFICAÇÃO DE LETRAS <- núcleo da lógica 

Função pura: recebe estado + chute, devolve resultado 

============================================================ 

@dataclass(frozen=True) class ResultadoChute: valido: bool motivo_invalido: Optional[str] # None quando válido acertou: Optional[bool] # None quando inválido letra: str 

def verificar_chute(estado: EstadoJogo, chute: str) -> ResultadoChute: """ Valida e classifica um chute sem modificar o estado. 

Retorna um ResultadoChute descrevendo: 
 - se o chute é válido (formato correto e letra nova) 
 - se a letra está na palavra (quando válido) 
 
Mantida como função pura para facilitar testes unitários. 
""" 
letra = chute.strip().lower() 
 
if len(letra) != 1: 
   return ResultadoChute(valido=False, motivo_invalido="Digite apenas UMA letra.", acertou=None, letra=letra) 
 
if not letra.isalpha(): 
   return ResultadoChute(valido=False, motivo_invalido="Digite uma letra, não número ou símbolo.", acertou=None, letra=letra) 
 
if letra in estado.todas_letras_tentadas: 
   return ResultadoChute(valido=False, motivo_invalido=f"A letra '{letra}' já foi tentada.", acertou=None, letra=letra) 
 
acertou = letra in estado.palavra 
return ResultadoChute(valido=True, motivo_invalido=None, acertou=acertou, letra=letra) 
 

def aplicar_chute(estado: EstadoJogo, resultado: ResultadoChute) -> None: """ Atualiza o estado do jogo com base em um chute válido. Separado de verificar_chute para manter a verificação pura. """ if not resultado.valido: return 

if resultado.acertou: 
   estado.letras_corretas.add(resultado.letra) 
else: 
   estado.letras_erradas.add(resultado.letra) 
 

============================================================ 

MÓDULO DE RENDERIZAÇÃO 

Responsável apenas por montar strings para exibição 

============================================================ 

_FORCA = [ # 0 erros (" -----\n" " | |\n" " | \n" " | \n" " | \n" " |\n" "========="), # 1 erro - cabeça (" -----\n" " | |\n" " | O\n" " | \n" " | \n" " |\n" "========="), # 2 erros - corpo (" -----\n" " | |\n" " | O\n" " | |\n" " | \n" " |\n" "========="), # 3 erros - braço esquerdo (" -----\n" " | |\n" " | O\n" " | /|\n" " | \n" " |\n" "========="), # 4 erros - braço direito (" -----\n" " | |\n" " | O\n" " | /|\\n" " | \n" " |\n" "========="), # 5 erros - perna esquerda (" -----\n" " | |\n" " | O\n" " | /|\\n" " | / \n" " |\n" "========="), # 6 erros - perna direita (completo) (" -----\n" " | |\n" " | O\n" " | /|\\n" " | / \\n" " |\n" "========="), ] 

def renderizar_forca(erros: int) -> str: indice = min(erros, len(_FORCA) - 1) return _FORCA[indice] 

def renderizar_palavra(palavra: str, letras_corretas: set) -> str: """Exibe letras descobertas e traços para as ainda ocultas.""" return " ".join(l if l in letras_corretas else "_" for l in palavra) 

def renderizar_estado(estado: EstadoJogo) -> str: """Monta a tela completa de uma rodada.""" erradas_ordenadas = sorted(estado.letras_erradas) linhas = [ renderizar_forca(estado.erros), "", f"Palavra : {renderizar_palavra(estado.palavra, estado.letras_corretas)}", f"Erradas : {', '.join(erradas_ordenadas) if erradas_ordenadas else '-'}", f"Erros : {estado.erros}/{estado.max_erros}", ] return "\n".join(linhas) 

============================================================ 

MÓDULO DE FLUXO 

Orquestra os módulos acima em uma partida completa 

============================================================ 

def executar_partida() -> bool: """ Roda uma partida completa. Retorna True se o jogador ganhou, False se perdeu. """ palavra = sortear_palavra() estado = EstadoJogo(palavra=palavra) 

print("\n" + "=" * 40) 
print("       JOGO DA FORCA — BOA SORTE!") 
print("=" * 40) 
 
while not estado.encerrado: 
   print("\n" + renderizar_estado(estado)) 
 
   chute_raw = input("\nLetra: ") 
   resultado = verificar_chute(estado, chute_raw) 
 
   if not resultado.valido: 
       print(f"  ⚠  {resultado.motivo_invalido}") 
       continue 
 
   aplicar_chute(estado, resultado) 
 
   if resultado.acertou: 
       print(f"  ✔  '{resultado.letra}' está na palavra!") 
   else: 
       print(f"  ✘  '{resultado.letra}' não está na palavra.") 
 
# Tela final 
print("\n" + renderizar_estado(estado)) 
 
if estado.ganhou: 
   print(f"\n  Parabéns! Você acertou: {estado.palavra.upper()}") 
else: 
   print(f"\n  Você perdeu. A palavra era: {estado.palavra.upper()}") 
 
return estado.ganhou 
 

def main() -> None: """Ponto de entrada: gerencia o loop de partidas.""" vitorias = 0 partidas = 0 

while True: 
   ganhou = executar_partida() 
   partidas += 1 
   if ganhou: 
       vitorias += 1 
 
   print(f"\n  Placar: {vitorias} vitória(s) em {partidas} partida(s)") 
 
   resposta = input("\n  Jogar novamente? (s/n): ").strip().lower() 
   if resposta != "s": 
       print("\n  Até mais!\n") 
       break 
 

============================================================ 

PONTO DE ENTRADA 

============================================================ 

if name == "main": main() 

 
