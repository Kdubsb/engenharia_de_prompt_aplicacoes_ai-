Como um expert, para que seu código funcione em qualquer lugar sem depender de instalações externas, vou substituir a biblioteca requests pela urllib.request, que já vem nativa no Python (Standard Library). Além disso, farei um ajuste para contornar a limitação de buscar referências comerciais sem bibliotecas externas. 

Código Corrigido e Compatível (Sem Dependências Externas) 

Python 

import urllib.request 
import json 
from collections import deque 
import time 
class BuscadorEnderecoExpert: 
   def __init__(self): 
       # Gerencia automaticamente o limite de 10 itens 
       self.historico = deque(maxlen=10) 
 
   def fazer_requisicao(self, url): 
       """Método nativo para buscar dados via HTTP sem bibliotecas externas""" 
       try: 
           # Adicionando um User-Agent para evitar bloqueios de segurança 
           headers = {'User-Agent': 'Mozilla/5.0'} 
           req = urllib.request.Request(url, headers=headers) 
            
           with urllib.request.urlopen(req) as response: 
               if response.getcode() == 200: 
                   return json.loads(response.read().decode()) 
       except Exception: 
           return None 
       return None 
 
   def buscar_referencia(self, logradouro, cidade): 
       """Busca POIs próximos usando a API do OpenStreetMap (via urllib)""" 
       # Formata a string para a URL (substitui espaços por +) 
       query = urllib.parse.quote(f"{logradouro}, {cidade}") 
       url = f"https://nominatim.openstreetmap.org/search?format=json&q={query}&limit=1" 
        
       dados = self.fazer_requisicao(url) 
       if dados and len(dados) > 0: 
           # Retorna o nome do local ou a descrição simplificada 
           return dados[0].get('display_name', '').split(',')[0] 
       return "Referência local não mapeada" 
 
   def consultar(self, cep): 
       cep = "".join(filter(str.isdigit, cep)) 
        
       if len(cep) != 8: 
           print("❌ CEP deve ter 8 dígitos.") 
           return 
 
       print(f"📡 Conectando aos servidores para o CEP {cep}...") 
        
       # Consulta ViaCEP 
       url_viacep = f"https://viacep.com.br/ws/{cep}/json/" 
       dados_cep = self.fazer_requisicao(url_viacep) 
 
       if not dados_cep or "erro" in dados_cep: 
           print("❌ CEP não encontrado.") 
           return 
 
       # Busca referência baseada no logradouro retornado 
       ref = self.buscar_referencia(dados_cep['logradouro'], dados_cep['localidade']) 
 
       resultado = { 
           "cep": cep, 
           "endereco": f"{dados_cep['logradouro']}, {dados_cep['bairro']} - {dados_cep['localidade']}/{dados_cep['uf']}", 
           "referencia": ref, 
           "hora": time.strftime("%H:%M:%S") 
       } 
 
       self.historico.appendleft(resultado) 
       return resultado 
 
   def exibir_historico(self): 
       print("\n" + "="*45) 
       print("🕒 HISTÓRICO (ÚLTIMAS 10 PESQUISAS)") 
       print("="*45) 
       if not self.historico: 
           print("Nenhuma pesquisa realizada ainda.") 
       for i, item in enumerate(self.historico, 1): 
           print(f"{i}. [{item['hora']}] {item['cep']}") 
           print(f"   📍 {item['endereco']}") 
           print(f"   🚩 Referência: {item['referencia']}") 
           print("-" * 45) 
 
# --- Fluxo de Execução --- 
app = BuscadorEnderecoExpert() 
 
